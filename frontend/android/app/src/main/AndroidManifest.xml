<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: the
         androidx.health.connect:connect-client AAR declares minSdk 26; this app ships minSdk 24.
         Health Connect code is unreachable on API 24-25 anyway (getSdkStatus() reports unavailable),
         so the merge override is safe — it does not change the app's own minSdk. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect rationale entry point for Android 13 and below (Android 14+ uses the
                 activity-alias below). Both route to MainActivity; the WebView shows the step screen. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- documentation/Subfeatures/Vonalkódos élelmiszer beolvasás.md: @capacitor-mlkit/barcode-scanning -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui"/>

        <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: Health
             Connect requires a visible rationale for the READ_STEPS permission (both an activity
             action and, on Android 14+, the intent-filter alias below). The HealthConnectSteps
             native module handles the intent; see health-connect.plugin.ts. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: read-only
         daily step totals from Android Health Connect (Samsung Health data source). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- documentation/Features/Értesítések.md: local (device-scheduled) notifications, no server push.
         POST_NOTIFICATIONS is the Android 13+ runtime prompt; the exact-alarm permissions let the
         09:00 / 20:00 / event-start schedules fire on time. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
