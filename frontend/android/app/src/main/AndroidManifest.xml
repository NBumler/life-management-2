<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: the
         androidx.health.connect:connect-client AAR declares minSdk 26; this app ships minSdk 24.
         Health Connect code is unreachable on API 24-25 anyway (getSdkStatus() reports unavailable),
         so the merge override is safe — it does not change the app's own minSdk. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect rationale entry point for Android 13 and below (Android 14+ uses the
                 activity-alias below). Both route to MainActivity; the WebView shows the step screen. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- documentation/Subfeatures/Vonalkódos élelmiszer beolvasás.md: @capacitor-mlkit/barcode-scanning -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui"/>

        <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: Health
             Connect requires a visible rationale for the READ_STEPS permission (both an activity
             action and, on Android 14+, the intent-filter alias below). The HealthConnectSteps
             native module handles the intent; see health-connect.plugin.ts. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- documentation/Features/Értesítések.md "08:00 / 20:00 háttér-értesítés worker": two inexact
             daily AlarmManager alarms broadcast here; the receiver enqueues ReminderWorker and re-arms
             the next occurrence. Not exported — only this app's own alarms target it. -->
        <receiver
            android:name=".notifications.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Alarms do not survive a reboot; re-arm them on boot. -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- documentation/Subfeatures/Lépésszám átszinkronizálása a Samsung Health-ből.md: read-only
         daily step totals from Android Health Connect (Samsung Health data source). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- documentation/Features/Értesítések.md "08:00 / 20:00 háttér-értesítés worker": the 20:00
         ReminderWorker reads today's step total from Health Connect while the app is closed to decide
         the STEPS_LOW notification. Health Connect requires this extra grant for background reads;
         it is only requestable once READ_STEPS is already granted. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- documentation/Features/Értesítések.md: local (device-scheduled) notifications, no server push.
         POST_NOTIFICATIONS is the Android 13+ runtime prompt. No SCHEDULE_EXACT_ALARM: the 09:00 /
         20:00 / event-start reminders are scheduled inexact (isExactNotification: false) — a few
         minutes' drift is fine and the app-open reconcile is the safety net, so we avoid the
         "Alarms & reminders" settings redirect and the Play-review friction of exact alarms. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- documentation/Features/Értesítések.md "08:00 / 20:00 háttér-értesítés worker": re-arm the two
         inexact daily alarms after a device reboot. No SCHEDULE_EXACT_ALARM — the reminders are
         scheduled inexact and the app-open reconcile is the safety net. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
