# Postgres (docker-compose.yml + backend/src/main/resources/application-local.yml)
POSTGRES_USER=lm2
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lm2

# Spring Security JWT signing secret (backend)
LM2_JWT_SECRET=change-me

# Admin API key for /api/admin/** (X-Admin-Api-Key header, not JWT role)
LM2_ADMIN_API_KEY=change-me
